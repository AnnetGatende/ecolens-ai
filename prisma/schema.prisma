generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model PollutionReport {
  id                    String   @id @default(cuid())
  // Inside your PollutionReport model, add these two lines:
summary_sw        String?
recommendation_sw String?

  // Citizen Report
  description           String
  imageUrl              String?

  latitude              Float
  longitude             Float

  // Human-Readable Location
  county                String?
  subCounty             String?
  ward                  String?
  area                  String?
  displayLocation       String?

  userCategory          String?
  userSeverity          String?

  // Gemma AI Analysis
  pollutionType         String
  confidence            Float
  severity              String
  likelySource          String
  predictedAQI          Int
  healthRisk            String
  recommendation        String
  summary               String

  // Workflow
  status                ReportStatus @default(PENDING)
  municipalAlertSent    Boolean @default(false)
  hotspotDetected       Boolean @default(false)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

enum ReportStatus {
  PENDING
  ANALYZED
  ALERTED
  RESOLVED
}