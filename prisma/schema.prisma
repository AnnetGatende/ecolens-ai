generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// NEW: Admin Profile Tracking (Bilingual)
model AdminProfile {
  id          String   @id @default(uuid())
  name        String
  role        String   // English role (e.g., "Municipal Dispatcher")
  role_sw     String?  // Swahili translated role (e.g., "Msambazaji wa Manispaa")
  initials    String
  createdAt   DateTime @default(now())
}

model PollutionReport {
  id                String   @id @default(cuid())
  reportNumber      Int      @default(autoincrement()) // Generates 1, 2, 3... natively

  // Citizen Report
  description       String
  description_en    String?  // NEW: Gemma translated English
  description_sw    String?  // NEW: Gemma translated Swahili
  imageUrl          String?

  latitude          Float
  longitude         Float

  // Human-Readable Location
  county            String?
  subCounty         String?
  ward              String?
  area              String?
  displayLocation   String?

  userCategory      String?
  userSeverity      String?

  // Gemma AI Analysis (Strict Bilingual)
  pollutionType     String
  pollutionType_sw  String?
  confidence        Float
  severity          String
  severity_sw       String?  // NEW: Stores exact Swahili map legend term
  likelySource      String
  likelySource_sw   String?
  predictedAQI      Int
  healthRisk        String
  healthRisk_sw     String?
  recommendation    String
  recommendation_sw String?
  summary           String
  summary_sw        String?

  // Workflow
  status             ReportStatus @default(PENDING)
  municipalAlertSent Boolean @default(false)
  hotspotDetected    Boolean @default(false)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

enum ReportStatus {
  PENDING
  ANALYZED
  ALERTED
  RESOLVED
}